  \centering
  \caption{實驗硬軟體環境規格}
  \label{tab:spec}
  \renewcommand{\arraystretch}{1.3}
  \begin{tabularx}{\textwidth}{l X}
    \toprule
    \textbf{項目} & \textbf{規格} \\
    \midrule
    CPU              & （待填） \\
    記憶體           & （待填） \\
